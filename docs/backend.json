
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a user within the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authSystemId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["customer", "seller"] },
        "fullName": { "type": "string" }
      },
      "required": ["id", "authSystemId", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Represents a jewelry item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "currentStock": { "type": "number" },
        "sellerId": { "type": "string" }
      }
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Metadata for a chat inquiry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single chat bubble within a conversation.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profiles."
    },
    "/products/{productId}": {
      "schema": "#/backend/entities/Product",
      "description": "Jewelry items."
    },
    "/conversations/{convId}": {
      "schema": "#/backend/entities/Conversation",
      "description": "Chat conversation metadata."
    },
    "/conversations/{convId}/messages/{msgId}": {
      "schema": "#/backend/entities/ChatMessage",
      "description": "Chat messages."
    }
  }
}
