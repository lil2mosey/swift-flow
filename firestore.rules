rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check for authenticated users
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user is the owner of a document (by UID)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if the user is a seller using their profile
    function isSeller() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'seller';
    }

    match /userProfiles/{userId} {
      // Users can always read and write their own profile
      allow read, write: if isOwner(userId);
      // Allow other authenticated users to read profiles (needed for display names and role checks)
      allow read: if isAuthenticated();
    }

    match /products/{productId} {
      allow read: if true; // Public catalog access
      allow write: if isSeller();
    }

    match /orders/{orderId} {
      // Broad read/write access for authenticated users during development
      // Ensures both customers and sellers can synchronize orders
      allow read, write: if isAuthenticated();
    }

    match /messages/{messageId} {
      // Broad read/write access for authenticated users during development
      allow read, write: if isAuthenticated();
    }

    // Global wildcard for development safety
    match /{document=**} {
      allow read, write: if isAuthenticated() || request.time < timestamp.date(2026, 4, 3);
    }
  }
}
