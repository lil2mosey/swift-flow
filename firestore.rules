rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check for authenticated users
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check for specific administrative UIDs
    function isSuperUser() {
      return isAuthenticated() && (
        request.auth.uid == 'sreC0Eu3pNcTtybFH3zOmnFKA0h1' || 
        request.auth.uid == '3Q1aUMYWXkaWCq27Pgc5GhQdVKg2'
      );
    }

    // Explicit rules for core application collections to ensure list/get operations work
    match /userProfiles/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }

    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    match /{document=**} {
      // Grant full access to the specified administrative UIDs
      allow read, write: if isSuperUser();
      
      // Maintain general "Allow All" for development as requested
      // Note: This covers all users until the specified date.
      allow read, write: if request.time < timestamp.date(2026, 4, 3);
    }
  }
}