rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check for authenticated users
    function isAuthenticated() {
      return request.auth != null;
    }

    // Explicit rules for core application collections
    // These ensure that all authenticated users can list and get data
    match /userProfiles/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }

    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // Global wildcard for authenticated users during development
    match /{document=**} {
      allow read, write: if isAuthenticated() || request.time < timestamp.date(2026, 4, 3);
    }
  }
}