rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a robust identity-based authorization model.
     * Sellers have broad administrative access to manage platform logistics.
     * Customers are restricted to their own private data and public products.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Direct check for seller role in the user profile document
    function isSeller() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'seller';
    }

    // --- User Profiles ---
    match /userProfiles/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isSignedIn(); // Allow creation during registration
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // --- Product Catalog ---
    match /products/{productId} {
      // Public catalog is readable by anyone signed in
      allow get, list: if isSignedIn();
      // Only sellers can manage inventory
      allow create, update, delete: if isSeller();
    }

    // --- Order Management ---
    match /orders/{orderId} {
      // READ: Sellers see all. Customers see their own or manual DM orders assigned to them.
      // Note: We use 'resource.data' for existing docs and ensure the query filters match.
      allow get, list: if isSignedIn() && (
        isSeller() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.customerId == 'manual-dm'
      );
      
      // CREATE: Anyone signed in can place an order.
      allow create: if isSignedIn();
      
      // UPDATE: Sellers manage fulfillment. Customers confirm payment approval.
      allow update: if isSignedIn() && (
        isSeller() || 
        resource.data.customerId == request.auth.uid
      );
      
      allow delete: if false;

      // Subcollections (OrderItems, Payments)
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (
          isSeller() || 
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid
        );
      }
    }

    // --- Messages ---
    match /messages/{messageId} {
      allow get, list: if isSignedIn() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if false;
    }
  }
}