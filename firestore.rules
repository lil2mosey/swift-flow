rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a robust identity-based authorization model.
     * Sellers have broad administrative access to manage platform logistics.
     * Customers are restricted to their own private data and public products.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Direct check for seller role in the user profile document
    // We use exists() to prevent rule errors if the profile doc isn't created yet
    function isSeller() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'seller';
    }

    // --- User Profiles ---
    match /userProfiles/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId) || isSeller();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // --- Product Catalog ---
    match /products/{productId} {
      // Public catalog is readable by anyone signed in
      allow get, list: if isSignedIn();
      // Only sellers can manage inventory
      allow create, update, delete: if isSeller();
    }

    // --- Order Management ---
    match /orders/{orderId} {
      // Rule optimization for List operations:
      // Customers must use a filtered query matching their UID.
      // Sellers can use unfiltered queries.
      allow list: if isSignedIn() && (
        (resource.data.customerId == request.auth.uid) || 
        (resource.data.customerId == 'manual-dm' && isSeller()) ||
        isSeller()
      );
      
      allow get: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        isSeller() ||
        resource.data.customerId == 'manual-dm'
      );
      
      // Anyone signed in can place an order.
      allow create: if isSignedIn();
      
      // Sellers manage fulfillment. Customers confirm payment approval.
      allow update: if isSignedIn() && (
        isSeller() || 
        resource.data.customerId == request.auth.uid
      );
      
      allow delete: if false;

      // Subcollections (OrderItems, Payments)
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (
          isSeller() || 
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid
        );
      }
    }

    // --- Messages ---
    match /messages/{messageId} {
      allow get, list: if isSignedIn() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId ||
        isSeller()
      );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if false;
    }
  }
}