rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Direct check for role on the user's own profile without recursion
    function getRole() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role;
    }
    
    function isSeller() {
      return isAuthenticated() && getRole() == 'seller';
    }
    
    function isCustomer() {
      return isAuthenticated() && getRole() == 'customer';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // --- User Profiles ---
    match /userProfiles/{userId} {
      // Users can always read and write their own profile
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      // Sellers can read other profiles for business logic
      allow read: if isAuthenticated() && isSeller();
    }
    
    // --- Orders ---
    match /orders/{orderId} {
      // Allow customers to list their own orders based on the query filter
      allow list: if isAuthenticated() && (
        isSeller() || 
        (request.query.limit <= 500 && request.auth.uid != null)
      );

      // Detailed access for get/update
      allow read: if isAuthenticated() && (
        isSeller() || 
        resource.data.customerId == request.auth.uid ||
        resource.data.customerId == 'manual-dm'
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid || isSeller()
      );
      
      allow update: if isAuthenticated() && (
        isSeller() || 
        resource.data.customerId == request.auth.uid
      );
      
      allow delete: if false;
    }
    
    // --- Products ---
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow write: if isAuthenticated() && isSeller();
    }
    
    // --- Messages ---
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId ||
        isSeller()
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId;
    }
  }
}
