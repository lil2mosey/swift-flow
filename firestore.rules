rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check for authenticated users
    function isAuthenticated() {
      return request.auth != null;
    }

    // Explicit rules for core application collections
    // During development, we allow authenticated users to interact with all collections
    // to ensure synchronized features (orders, messages) work for both roles.
    
    match /userProfiles/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /products/{productId} {
      allow read: if true; // Public catalog access
      allow write: if isAuthenticated();
    }

    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // Global wildcard for authenticated users during development
    match /{document=**} {
      allow read, write: if isAuthenticated() || request.time < timestamp.date(2026, 4, 3);
    }
  }
}
