service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Orders logic:
    match /orders/{orderId} {
      // Allow any logged-in user to create an order (The Instagram Customer)
      allow create: if request.auth != null;
      
      // Allow the Admin (Seller) to see ALL orders, 
      // and Customers to see ONLY their own orders.
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller' ||
        resource.data.customerId == request.auth.uid
      );
      
      // Only the Admin (Seller) can update or delete orders
      allow update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    // 3. Products logic (maintained for storefront functionality):
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }
  }
}