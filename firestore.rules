rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Shared access for authenticated users to ensure role-based logic works
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Global access for products to allow catalog viewing
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Orders access: Sellers see all, Customers see theirs
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
    
    // Messages access: Participants only
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Temporary broad access for other collections during development
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}