service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Orders logic:
    match /orders/{orderId} {
      // Allow any logged-in user to create an order
      allow create: if request.auth != null;
      
      // Ownership-based reading (Supports Query-Aware Permission proved by query filters)
      // Consolidated for performance and to ensure QAP optimization for both roles
      allow read: if request.auth != null && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      
      // Update/Delete: Restricted to the seller or owner
      // We check for seller role via a get() call for mutations, which is safe
      allow update, delete: if request.auth != null && (
        resource.data.sellerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller'
      );
    }

    // 3. Products logic:
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    // 4. Conversations logic:
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && 
        (resource.data.customerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
        
      match /messages/{messageId} {
        allow read, write: if request.auth != null && 
          (resource.data.customerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      }
    }

    // 5. Admin Roles logic:
    match /admin_roles/{adminId} {
      allow read: if request.auth != null;
      allow write: if false; // System-managed
    }
  }
}