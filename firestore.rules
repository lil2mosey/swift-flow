rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a flexible identity-based authorization model for the musaa marketplace.
     * It allows sellers full administrative visibility into all orders to streamline logistics,
     * while restricting customers to their own private purchase history.
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper to check the user's role from their profile
    function isSeller() {
      return isSignedIn() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'seller';
    }

    function isDataOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // --- Collection Rules ---

    /**
     * @description User profiles (customers and sellers).
     */
    match /userProfiles/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Global product catalog.
     */
    match /products/{productId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSeller();
    }

    /**
     * @description Order management. Sellers see ALL orders. Customers see their OWN orders.
     */
    match /orders/{orderId} {
      // List/Get: Sellers see everything. Customers filter by their UID.
      allow get, list: if isSeller() || (isSignedIn() && (resource.data.customerId == request.auth.uid || request.auth.uid == 'manual-dm'));
      
      // Create: Anyone signed in can place an order.
      allow create: if isSignedIn();
      
      // Update: Sellers manage fulfillment. Customers confirm payment.
      allow update: if isSeller() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      
      allow delete: if false;

      // Subcollections inherit logic or use denormalized fields
      match /{allSubcollections=**} {
        allow read, write: if isSeller() || (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid);
      }
    }

    /**
     * @description Messages.
     */
    match /messages/{messageId} {
      allow get, list: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if false;
    }
  }
}